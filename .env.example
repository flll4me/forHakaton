# Скопируйте в .env и заполните. Реальные ключи в репозиторий не коммитить.

# Пути к данным (по умолчанию data/raw/handout)
# DATA_DIR=data/raw/handout
# RULES_PATH=data/raw/handout/rules.json
# TAXONOMY_PATH=data/raw/handout/taxonomy.json

# Эмбеддинги для RAG/дедупликации (sentence-transformers). false = только лексический поиск.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM: none | anthropic | openai_compatible
# LLM_ENABLED=false выключает LLM при любом провайдере (черновики только по шаблонам)
LLM_ENABLED=true
LLM_PROVIDER=none
LLM_MODEL=
# Для openai_compatible (в т.ч. локальный сервер, напр. Ollama/vLLM): http://localhost:11434/v1
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_S=3.0
LLM_MAX_INPUT_TOKENS=1500
LLM_MAX_OUTPUT_TOKENS=250
# Цена модели, $ за 1M токенов — нужна для расчёта стоимости
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
LLM_MAX_COST_PER_TICKET=0.002

# Пороги эскалации
MIN_CATEGORY_CONFIDENCE=0.55
MIN_RETRIEVAL_SCORE=0.25
DUPLICATE_WINDOW_MINUTES=60
DUPLICATE_SIMILARITY=0.6
RELATED_SIMILARITY=0.3
